{
  "expo": {
    "name": "Nova Player",
    "slug": "nova-player",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "novaplayer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novaplayer.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Nova Player needs access to your photo library to browse and play your video files.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.novaplayer.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "content",
              "mimeType": "video/*"
            },
            {
              "scheme": "file",
              "mimeType": "video/*"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Nova Player to access your video files.",
          "savePhotosPermission": "Allow Nova Player to save video thumbnails and snapshots.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-screen-orientation",
      "expo-brightness",
      "expo-image",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ]
    ]
  }
}
